# DeepSeek API 密钥（必填，用于 AI 摘要/翻译/综述）
# 方式A（推荐，防盗用）：把明文填入本文件后，运行 `python tools/store_key.py`
#   脚本会用 Windows DPAPI 加密并清除明文，.env 只保留下面的 DEEPSEEK_API_KEY_ENC
# 方式B（简单）：直接明文填写 DEEPSEEK_API_KEY
DEEPSEEK_API_KEY=sk-你的密钥
DEEPSEEK_API_KEY_ENC=

# QQ 邮箱 SMTP 授权码（用于定时发送报告邮件）
# 推荐运行 `python tools/store_smtp.py` 交互录入（输入不回显，DPAPI 加密后
# 只保留 QQ_SMTP_AUTH_ENC）；授权码是 16 位纯字母数字，不是 QQ 密码
QQ_SMTP_AUTH=
QQ_SMTP_AUTH_ENC=
