# 智谱 BigModel API 密钥（必填，用于 AI 摘要/翻译/综述）
# 推荐直接运行 `python tools/store_key.py` 交互录入，明文不会落盘；
# 也可临时明文填写 BIGMODEL_API_KEY，再运行该脚本加密并清除明文。
BIGMODEL_API_KEY=
BIGMODEL_API_KEY_ENC=

# QQ 邮箱 SMTP 授权码（用于定时发送报告邮件）
# 推荐运行 `python tools/store_smtp.py` 交互录入（输入不回显，DPAPI 加密后
# 只保留 QQ_SMTP_AUTH_ENC）；授权码是 16 位纯字母数字，不是 QQ 密码
QQ_SMTP_AUTH=
QQ_SMTP_AUTH_ENC=

# 发件/收件邮箱（本地保存，不进公开仓库；多个收件邮箱用英文逗号分隔）
SMTP_FROM_ADDR=
SMTP_TO_ADDRS=
