# ============================================================
# 环境变量示例（复制为 .env 后填写；.env 已被 .gitignore 排除）
# 推荐直接用交互式脚本录入，明文不会落盘：
#   python tools/store_key.py    # AI 密钥
#   python tools/store_smtp.py   # QQ 邮箱授权码 + 发件/收件地址
# ============================================================

# ---------- AI 密钥（必填，用于摘要/翻译/综述）----------
# 当前使用 DeepSeek（config.yaml: ai.provider=deepseek, ai.api_key_env=DEEPSEEK_API_KEY）
# 也可临时明文填写 DEEPSEEK_API_KEY，再运行 tools/store_key.py 加密并清除明文
DEEPSEEK_API_KEY=
DEEPSEEK_API_KEY_ENC=

# 备选服务商：智谱 BigModel（把 config.yaml 的 ai.provider 改为 bigmodel）
BIGMODEL_API_KEY=
BIGMODEL_API_KEY_ENC=

# ---------- QQ 邮箱 SMTP 授权码（用于定时发送报告邮件）----------
# 授权码是 16 位纯字母数字，不是 QQ 密码；
# 推荐运行 tools/store_smtp.py 交互录入（输入不回显，DPAPI 加密后只保留
# QQ_SMTP_AUTH_ENC）
QQ_SMTP_AUTH=
QQ_SMTP_AUTH_ENC=

# 发件/收件邮箱（本地保存，不进公开仓库；多个收件邮箱用英文逗号分隔）
SMTP_FROM_ADDR=
SMTP_TO_ADDRS=
